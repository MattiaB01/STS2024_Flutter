      backgroundColor: Colors.blueAccent,
      appBar: AppBar(
        title: const Text('Dettaglio fattura'),
        // backgroundColor: Theme.of(context).colorScheme.inversePrimary,
        backgroundColor: Colors.blueAccent.withOpacity(0.9),
